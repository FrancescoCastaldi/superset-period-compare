# Dockerfile.production
# Production-ready Dockerfile for Apache Superset 6.1.0 with PeriodCompare.
#
# Produces an enterprise-grade, lightweight production container:
# - Base: official apache/superset:6.1.0
# - Zero Node.js runtime footprint
# - Atomic PeriodCompare backend logic overlay
# - Fully compatible with pre-compiled frontend static assets
#
# Usage:
#   docker build -f docker/Dockerfile.production -t superset:6.1.0-period-compare .

ARG SUPERSET_BASE_VERSION=6.1.0

# -----------------------------------------------------------------------------
# Runtime Production Image
# -----------------------------------------------------------------------------
FROM apache/superset:${SUPERSET_BASE_VERSION} AS final

USER root

# 1. Overlay patched backend files (helpers.py, query_object.py, constants.py, config.py)
COPY payload/superset/ /app/superset/

# 2. Ensure non-privileged superset user permissions
RUN chown -R superset:superset /app/superset

USER superset

ENV SUPERSET_ENV=production \
    FLASK_ENV=production

EXPOSE 8088

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f "http://localhost:8088/health" || exit 1

CMD ["/usr/bin/run-server.sh"]
