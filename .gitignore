# Superset Period Compare .gitignore

# Backups generated during installation
.backups/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
.pytest_cache/
.coverage

# Node artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files & logs
*.log
*.tmp
temp/

# Local git worktrees and editor files
.worktrees/
.vscode/
.idea/
*.bak
